# Copy to .env and fill in. Never commit .env itself.

# Where the SQLite file lives. The folder is created automatically.
DATABASE_FILE=./data/jars.db

# Port for the local server.
PORT=3000

# Set to "production" once deployed. This is what makes session cookies
# HTTPS-only, so leave it unset locally or logging in over http will fail.
NODE_ENV=development

# Public origin, used to build password-reset links. No trailing slash.
APP_URL=http://localhost:3000

# How long a reset link stays valid.
RESET_TOKEN_MINUTES=45

# ---- Email ----------------------------------------------------------------
# Leave these blank in development: reset links are printed to the server
# console instead of being emailed. Fill them in to send real mail.
#
# Gmail needs an App Password, not your normal one.
#   EMAIL_HOST=smtp.gmail.com   EMAIL_PORT=587
# Resend:
#   EMAIL_HOST=smtp.resend.com  EMAIL_PORT=587  EMAIL_USER=resend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=jars <no-reply@example.com>
