# Copy to .env.local for local work. Never commit .env.local itself.
# On Vercel these go in Settings -> Environment Variables instead.

# ---- Database (required) --------------------------------------------------
# Neon connection string. From the Neon dashboard, or added for you if you
# attach Neon from Vercel's Storage tab. Use the pooled connection string.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ---- Public address (required in production) ------------------------------
# Used to build password-reset links. No trailing slash.
# Leave unset locally and the request's own host is used.
APP_URL=https://your-app.vercel.app

# How long a reset link stays valid.
RESET_TOKEN_MINUTES=45

# ---- Email (optional) -----------------------------------------------------
# Without a key, reset links are printed to the server log instead of sent.
# Get one at https://resend.com — the free tier is 3,000 emails a month.
#
# Until you verify a domain, Resend will only deliver to the address you
# signed up with, and EMAIL_FROM must stay onboarding@resend.dev.
RESEND_API_KEY=
EMAIL_FROM=jars <onboarding@resend.dev>
